# Workforce Attrition Analytics — Environment Configuration
# Copy this file to .env and fill in your values

# ── PostgreSQL ──────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=workforce_analytics
PG_USER=postgres
PG_PASSWORD=your_password_here

# ── HRIS / Payroll System ────────────────────────────────────
HRIS_API_URL=https://your-hris-system.com/api
HRIS_API_KEY=

# ── Jira ─────────────────────────────────────────────────────
JIRA_URL=https://your-org.atlassian.net
JIRA_USER=your-email@company.com
JIRA_TOKEN=

# ── GitHub ───────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_ORG=your-github-org

# ── LMS (Learning Management System) ─────────────────────────
LMS_API_URL=
LMS_API_KEY=

# ── Pipeline Settings ────────────────────────────────────────
DATA_DIR=./data/raw
LOG_LEVEL=INFO

# ── Model Settings ───────────────────────────────────────────
ATTRITION_THRESHOLD=0.75
MODEL_PATH=./models/artifacts/attrition_model.json
